{
  "name": "mapa-delito-usina",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test:watch": "node --import tsx --test --watch \"tests/**/*.test.ts\"",
    "georef:actualizar": "tsx scripts/actualizar-centroides.ts",
    "catalogo:auditar": "python3 scripts/ingesta/auditar-catalogo-snic.py",
    "catalogo:verificar": "python3 scripts/ingesta/auditar-catalogo-snic.py --no-escribir --check",
    "test:catalogo": "python3 -m unittest discover -s tests/ingesta -p 'test_*.py'",
    "pipeline:dry": "cross-env PIPELINE_DRY_RUN=true tsx scripts/pipeline/scrapear-medios.ts",
    "pipeline:run": "cross-env PIPELINE_DRY_RUN=false tsx scripts/pipeline/scrapear-medios.ts",
    "pipeline:medio": "tsx scripts/pipeline/scrapear-medios.ts --medio=",
    "pipeline:infobae": "tsx scripts/pipeline/scrapear-medios.ts --medio=infobae",
    "pipeline:rosario3": "tsx scripts/pipeline/scrapear-medios.ts --medio=rosario3",
    "postinstall": "node -e \"var fs=require('fs'),p=require('path'),d=p.join('node_modules','@duckdb','duckdb-wasm','dist'),o=p.join('public','duckdb');if(!fs.existsSync(d)){console.log('DuckDB dist not found, CDN fallback');process.exit(0)}fs.mkdirSync(o,{recursive:true});['duckdb-mvp.wasm','duckdb-browser-mvp.worker.js','duckdb-eh.wasm','duckdb-browser-eh.worker.js'].forEach(function(f){var s=p.join(d,f);if(fs.existsSync(s)){fs.copyFileSync(s,p.join(o,f));console.log(f+' ok')}});\"",
    "export:parquet": "duckdb < scripts/export/export_parquet.sql"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.32.0",
    "@prisma/client": "^6.19.2",
    "@vis.gl/react-google-maps": "^1.7.1",
    "agent-browser": "^0.21.4",
    "dotenv": "^17.3.1",
    "h3-js": "^4.4.0",
    "lucide-react": "^0.577.0",
    "next": "14.2.35",
    "next-auth": "5.0.0-beta.32",
    "openai": "^6.32.0",
    "papaparse": "^5.5.3",
    "prisma": "^6.19.2",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^3.8.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/jsdom": "27.0.0",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "jsdom": "27.0.0",
    "pg": "^8.20.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
