# Base de datos (Neon PostgreSQL con pgvector/postgis)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Google Maps (expuesta al browser — prefijo NEXT_PUBLIC_ obligatorio)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ── Proveedor LLM del pipeline ──
# OpenCode Go (activo). API compatible con OpenAI en https://opencode.ai/zen/go/v1
# Key desde el dashboard de Go. Catálogo: https://opencode.ai/zen/go/v1/models
OPENCODE_API_KEY=
# Overrides opcionales: solo si Go renombra o discontinúa un modelo.
# Defaults: economico=deepseek-v4-flash, preciso=deepseek-v4-pro
OPENCODE_MODELO_ECONOMICO=
OPENCODE_MODELO_PRECISO=

# OpenRouter — proveedor de respaldo (PIPELINE_PERFIL_MODELO=openrouter).
# Con la key cargada, si OpenCode Go no responde el pipeline sigue solo con
# OpenRouter en lugar de fallar.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324

# Pipeline de medios
# PIPELINE_DRY_RUN solo afecta a las corridas lanzadas a mano desde la consola;
# las del panel y la programada deciden su modo solas.
PIPELINE_DRY_RUN=true
PIPELINE_MAX_NOTICIAS=10
PIPELINE_PERFIL_MODELO=economico
# opciones: economico | preciso | openrouter | local
# A qué perfil caer si el principal no responde (default: openrouter si hay key)
PIPELINE_PERFIL_RESPALDO=
# Razonamiento del modelo: bajo | desactivado | alto | max (vacío = el del proveedor).
# deepseek-v4-flash piensa en "alto" por defecto: 'bajo' acelera mucho cada corrida.
PIPELINE_LLM_RAZONAMIENTO=
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# Agente local (docs/agente-local.md) — solo en la computadora que scrapea
PIPELINE_AGENTE_NOMBRE=
PIPELINE_AGENTE_HORA=07:00
PIPELINE_SNAPSHOT_MAX_CHARS=10000

# NextAuth — autenticación Google para /admin
NEXTAUTH_URL=https://tu-dominio.vercel.app
AUTH_SECRET=genera-con-openssl-rand-base64-32
# alias: NEXTAUTH_SECRET (next-auth v5 acepta ambos, usar AUTH_SECRET en Vercel)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAILS=email1@gmail.com,email2@gmail.com  # Correos autorizados para /admin (separados por coma)
# Cron job — pipeline automático
CRON_SECRET=genera-con-openssl-rand-base64-32
